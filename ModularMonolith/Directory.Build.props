<Project>
  <PropertyGroup>
    <NoWarn>$(NoWarn);RS1041</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.Contains('Testing'))">
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Include Architecture.EventsManagement Analyzer for all EventsManagement module projects except the analyzer itself and test projects -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.EventsManagement')) AND '$(MSBuildProjectName)' != 'Architecture.EventsManagement' AND !$(MSBuildProjectName.Contains('Testing'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Modules\EventsManagement\Architecture.EventsManagement\Architecture.EventsManagement.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Include Architecture.Bookings Analyzer for all Bookings module projects except the analyzer itself and test projects -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Bookings')) AND '$(MSBuildProjectName)' != 'Architecture.Bookings' AND !$(MSBuildProjectName.Contains('Testing'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Modules\Bookings\Architecture.Bookings\Architecture.Bookings.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Include Architecture.Notifications Analyzer for all Notifications module projects except the analyzer itself and test projects -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Notifications')) AND '$(MSBuildProjectName)' != 'Architecture.Notifications' AND !$(MSBuildProjectName.Contains('Testing'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Modules\Notifications\Architecture.Notifications\Architecture.Notifications.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>